# Database
# IMPORTANT: the password appears in TWO places — POSTGRES_PASSWORD and inside
# DATABASE_URL. They must match. If you rotate the password, update both lines.
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB are used by the postgres
# container (docker-compose) to initialize the database. DATABASE_URL is read
# by Prisma to connect. Generate a strong password with:
#   openssl rand -base64 32
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme-generate-strong-password
POSTGRES_DB=noghosting
DATABASE_URL=postgresql://changeme:changeme-generate-strong-password@localhost:5432/noghosting

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API
PORT=3001
NODE_ENV=development
